# Copy to .env; process environment variables take precedence.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_BYTES=10485760
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://ollama:11434
QWEN_MODEL=qwen3:1.7b
QWEN_TIMEOUT=120
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT=60
RAG_CHUNK_SIZE=500
RAG_TOP_K=3
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLISH_HOST=127.0.0.1
API_PUBLISH_PORT=8000
OLLAMA_PUBLISH_HOST=127.0.0.1
OLLAMA_PORT=11434
PYTHON_IMAGE=python:3.11-slim
OLLAMA_IMAGE=ollama/ollama:latest
PYTHONUNBUFFERED=1
