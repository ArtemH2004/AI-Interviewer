{
  "manifest_version": 3,
  "name": "AI Interview Assistant",
  "version": "0.2.0",
  "description": "AI-ассистент для помощи в прохождении собеседований",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "tabCapture", "activeTab"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "AI Interview Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
